# aaPanel 地址只填面板根地址，不要把入口路径拼进去。
AAPANEL_BASE_URL=https://your-panel-host:port
AAPANEL_ENTRANCE=/your-panel-entrance
AAPANEL_USERNAME=
AAPANEL_PASSWORD=
# 面板启用安全入口后偶尔会短暂返回 404；部署器在此时间内自动重试。
PANEL_LOGIN_WAIT_SECONDS=60

# 项目参数。LOCAL_ROOT 不配置，部署脚本自动使用脚本所在目录。
PROJECT_NAME=ocr
PROJECT_DOMAIN=ocr.example.com
PROJECT_PORT=47259
# aaPanel domain binding port. Keep 80 for the normal reverse-proxy vhost;
# change to PROJECT_PORT only if this aaPanel build explicitly requires it.
PROJECT_DOMAIN_PORT=80
# aaPanel Python 项目添加或修改时，运行权限选择 root。
PROJECT_USER=root
# 可选。填写 aaPanel 中的环境名称；留空时自动选择可执行的 Python。
PYTHON_ENV_NAME=

# 已有项目自动读取 aaPanel 中的项目目录；新项目填写服务器上的实际项目目录。
REMOTE_ROOT=

# true 时保留远程已有 ocr_access.json；首次部署建议 false。
PRESERVE_REMOTE_ACCESS_CONFIG=false

# true 时部署前要求本地 models/ 存在且非空。
OCR_REQUIRE_LOCAL_MODELS=true

# true 时自动检测并安装 OCR 所需 Linux 运行库，例如 libGL、glib2。
AUTO_INSTALL_SYSTEM_DEPS=true

# 自动安装依赖使用的源名称：default/aliyun/tsinghua/tencent/huawei/pypi，
# 也可以填写完整的 HTTP(S) Python 包索引地址。
PIP_SOURCE=default
INSTALL_WAIT_SECONDS=7200
VERIFY_PUBLIC_URL=true
PROJECT_SCHEME=https
# true 时由 aaPanel SSL 管理器自动申请并部署 Let's Encrypt 证书；
# false 时只绑定已经存在的匹配证书。
AUTO_APPLY_SSL=true
