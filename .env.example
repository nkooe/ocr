OCR_MAX_IMAGE_BYTES=8388608
OCR_LANGUAGE=ch
OCR_VERSION=PP-OCRv5
OCR_DEVICE=cpu
OCR_CPU_THREADS=2
OCR_REQUIRE_LOCAL_MODELS=true
OCR_TEXT_DETECTION_MODEL_NAME=PP-OCRv5_server_det
OCR_TEXT_DETECTION_MODEL_DIR=models/PP-OCRv5_server_det_infer
OCR_TEXT_RECOGNITION_MODEL_NAME=PP-OCRv5_server_rec
OCR_TEXT_RECOGNITION_MODEL_DIR=models/PP-OCRv5_server_rec_infer
OCR_TEXT_DET_LIMIT_TYPE=min
OCR_TEXT_DET_LIMIT_SIDE_LEN=64
OCR_TEXT_REC_SCORE_THRESH=0.0
